"<a href=\"%1$s\" target=\"_blank\">Auto-Create Coupons Addon Settings</a>."
msgstr ""
"<a href=\"%1$s\" target=\"_blank\">Ustawienia Addon Auto-Create Coupons</a>."

#: app/Addons/AutoCreateCoupons/Addon.php:388
msgid "You can read more about how the addon works at:"
