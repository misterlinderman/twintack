#~ msgstr "Plantilla de correo electrónico predeterminada"

#~ msgid "Email Template"
#~ msgstr "Plantilla de correo electrónico"

#~ msgid "Email Notifications"
#~ msgstr "Notificaciones por Correo electrónico"

