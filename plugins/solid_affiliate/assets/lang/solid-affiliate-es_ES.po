#~ msgid "Allow Affiliates to Create and Delete Slugs"
#~ msgstr "Permitir que los afiliados creen y eliminen babosas"

#~ msgid ""
#~ "Allow all affiliates to create and delete their own custom slugs. If you "
#~ "would like to only allow certain affiliates to create their own custom "
#~ "slugs, then uncheck this setting and you can instead toggle this setting "
#~ "on a per-affiliate basis on the affiliate edit page."
#~ msgstr ""
#~ "Permitir a todos los afiliados crear y eliminar sus propios slugs "
#~ "personalizados. Si desea que sólo algunos afiliados puedan crear sus "
#~ "propios slugs personalizados, desmarque esta opción y en su lugar puede "
#~ "activar esta opción de forma individual en la página de edición del "
#~ "afiliado."

#~ msgid "Per Affiliate Custom Slug Limit"
#~ msgstr "Límite de babosas personalizadas por afiliado"

#~ msgid ""
#~ "Limit how many different custom slugs a single affiliate can own and use "
#~ "in their Affiliate Links. Custom slugs are unique across you affiliate "
#~ "program, so allowing a single affiliate to own too many may hinder other "
#~ "affiliates."
#~ msgstr ""
#~ "Limite el número de babosas personalizadas diferentes que un mismo "
#~ "afiliado puede poseer y utilizar en sus enlaces de afiliación. Los slugs "
#~ "personalizados son únicos en todo su programa de afiliación, por lo que "
#~ "permitir que un solo afiliado posea demasiados puede perjudicar a otros "
#~ "afiliados."

#~ msgid "Auto Create Affiliate Username Slug"
#~ msgstr "Crear automáticamente el nombre de usuario del afiliado Slug"

#~ msgid ""
#~ "If turned on, then all New and Approved Affiliates will be given a "
#~ "default slug equal to the alphanumeric version of their WordPress "
#~ "username. An Affiliate will not received their auto created slug until "
#~ "they are Approved."
#~ msgstr ""
#~ "Si se activa, todos los Afiliados Nuevos y Aprobados recibirán un slug "
#~ "por defecto igual a la versión alfanumérica de su nombre de usuario en "
#~ "WordPress. Un Afiliado no recibirá su slug autocreado hasta que sea "
#~ "Aprobado."

#~ msgid ""
#~ "If there is a conflict with another Affiliate's username, then a number "
#~ "will be added to the end of the username."
#~ msgstr ""
#~ "Si hay un conflicto con el nombre de usuario de otro afiliado, se añadirá "
#~ "un número al final del nombre de usuario."

#~ msgid "Credit Last Affiliate"
#~ msgstr "Crédito Último afiliado"

#~ msgid ""
#~ "Currently always enabled. Simply put, if multiple Affiliates send you the "
#~ "same person then the last Affiliate will receive credit for any "
#~ "purchases. Other attribution strategies are coming soon."
#~ msgstr ""
#~ "Actualmente está siempre activado. En pocas palabras, si varios afiliados "
#~ "le envían a la misma persona, el último afiliado recibirá el crédito por "
#~ "cualquier compra. Otras estrategias de atribución están por llegar."

#~ msgid ""
#~ "When calculating referral amount, exclude shipping costs. (Will result in "
#~ "lower commission payments on items with shipping costs)."
#~ msgstr ""
#~ "Al calcular el importe de la recomendación, excluya los gastos de envío. "
#~ "(Se traducirá en pagos de comisiones más bajos en los artículos con "
#~ "gastos de envío)."

#~ msgid ""
#~ "When calculating referral amount, exclude taxes. (Will result in lower "
#~ "commission payments on taxed items)."
#~ msgstr ""
#~ "Al calcular el importe de las referencias, excluya los impuestos. "
#~ "(Resultará en pagos de comisiones más bajos en artículos gravados)."

#~ msgid "New Customer Commissions"
#~ msgstr "Comisiones para nuevos clientes"

#~ msgid ""
#~ "This setting ensures that affiliates are only awarded commissions for "
#~ "referring <strong>new</strong> customers (those making their first-ever "
#~ "purchase from your online store). When enabled, no referrals will be "
#~ "generated for returning customer. Subscriptions will always generate "
#~ "subscription renewal referrals if you have subscription renewal referrals "
#~ "enabled and configured."
#~ msgstr ""
#~ "Esta configuración asegura que los afiliados sólo reciban comisiones por "
#~ "referir <strong>nuevos</strong> clientes (aquellos que hacen su primera "
#~ "compra en su tienda online)."

#~ msgid "Enable Zero Value Referrals"
#~ msgstr "Activar las remisiones de valor cero"

#~ msgid ""
#~ "Enable this setting to allow affiliates to earn a referral even when the "
#~ "commission is of zero value (i.e. $0.00). This is disabled by default."
#~ msgstr ""
#~ "Este ajuste permite a los afiliados ganar un Referido incluso cuando la "
#~ "comisión es de valor cero (es decir, $0.00). Esta opción está desactivada "
#~ "por defecto."

#~ msgid "Prevent Self Referrals"
#~ msgstr "Referidos recientes"

#~ msgid ""
#~ "Enable this setting to prevent affiliates from generating referrals for "
#~ "their own purchases. Enabled by default."
#~ msgstr ""
#~ "Habilite esta configuración para evitar que los afiliados generen "
#~ "referencias para sus propias compras. Activado por defecto."

#~ msgid "Cookie Expiration Days"
#~ msgstr "Días de caducidad de las cookies"

#~ msgid "Expire the referral tracking cookie after this many days."
#~ msgstr ""
#~ "Expirar la cookie de seguimiento de referencias después de este número de "
#~ "días."

#~ msgid "Referral Grace Period Days"
#~ msgstr "Días del período de gracia de la remisión"

#~ msgid ""
#~ "Set the Referral grace period number of days. This is used by the Pay "
#~ "Affiliates feature to give the convenient option of paying all Referrals "
#~ "which are older than the grace period. Recommended: set this equal to "
#~ "your store refund policy, to minimize the chances of paying an Affiliate "
#~ "for a Referral while you are still liable to issue a refund for the "
#~ "underlying purchase."
#~ msgstr ""
#~ "Establezca el número de días del periodo de gracia de los referidos. Esto "
#~ "es utilizado por la función de Pago a Afiliados para dar la opción "
#~ "conveniente de pagar todos los Referidos que son más antiguos que el "
#~ "período de gracia. Recomendado: establezca este número igual a la "
#~ "política de reembolso de su tienda, para minimizar las posibilidades de "
#~ "pagar a un afiliado por un referido mientras que usted todavía es "
#~ "responsable de emitir un reembolso por la compra subyacente."

#~ msgid "Minimum Payout Amount"
#~ msgstr "Cantidad mínima de pago"

#~ msgid ""
#~ "Set the minimum payout amount. This is used by the Pay Affiliates tool to "
#~ "prevent paying out small amounts of money to Affiliates. Affiliates will "
#~ "not show up in the Pay Affiliates tool until they have at least this "
#~ "amount in unpaid referrals that match the chosen filters."
#~ msgstr ""
#~ "Establezca la cantidad mínima de pago. Esto es utilizado por la "
#~ "herramienta Pagar a Afiliados para evitar el pago de pequeñas cantidades "
#~ "de dinero a los Afiliados. Los afiliados no aparecerán en la herramienta "
#~ "Pagar a Afiliados hasta que tengan al menos esta cantidad en referidos no "
#~ "pagados que coincidan con los filtros elegidos."

#~ msgid "Enable Lifetime Commissions"
#~ msgstr "Habilitar las comisiones de por vida"

#~ msgid ""
#~ "Enable the Lifetime Commissions feature set. Allow all affiliates to "
#~ "receive a commission on all future purchases by the customers they "
#~ "referred."
#~ msgstr ""
#~ "Habilite el conjunto de características de las comisiones de por vida. "
#~ "Permita que todos los afiliados reciban una comisión por todas las "
#~ "compras futuras de los clientes que hayan referido."

#~ msgid ""
#~ "Automatically link a customer to the referring affiliate anytime a "
#~ "referral is earned. If disabled, you can still manually link customers "
#~ "and affiliates in Solid Affiliate > Affiliates > Lifetime Customers."
#~ msgstr ""
#~ "Vincular automáticamente un cliente con el afiliado que lo ha referido "
#~ "cada vez que se gane una referencia. Si está desactivado, aún puede "
#~ "vincular manualmente a los clientes y afiliados en Afiliación sólida > "
#~ "Afiliados > Clientes de por vida."

#~ msgid "Lifetime Commission Duration"
#~ msgstr "Duración de la comisión de por vida"

#~ msgid ""
#~ "The duration of the lifetime customer relationship. The default is no "
#~ "limit."
#~ msgstr ""
#~ "La duración de la relación con el cliente de por vida. El valor por "
#~ "defecto es sin límite."

#~ msgid "Only New Customers"
#~ msgstr "Sólo los nuevos clientes"

#~ msgid ""
#~ "Only allow lifetime commissions to only be earned for referring brand new "
#~ "customers. This will prevent existing customers (those who have made an "
#~ "order on your store in the past) from generating lifetime commissions."
#~ msgstr ""
#~ "Permita que las comisiones de por vida sólo se ganen por referir a "
#~ "clientes nuevos. Esto evitará que los clientes existentes (aquellos que "
#~ "han hecho un pedido en su tienda en el pasado) generen comisiones de por "
#~ "vida."

#~ msgid "Show Affiliates their customers"
#~ msgstr "Mostrar a los afiliados sus clientes"

#~ msgid ""
#~ "Enable this if you would like the affiliate portal to add a tab which "
#~ "shows the affiliates all their lifetime customers. The data is "
#~ "anonymized, the affiliates do not see any sensitive information."
#~ msgstr ""
#~ "Habilite esta opción si desea que el portal de afiliados añada una "
#~ "pestaña que muestre a los afiliados todos sus clientes de toda la vida. "
#~ "Los datos son anónimos, los afiliados no ven ninguna información sensible."

